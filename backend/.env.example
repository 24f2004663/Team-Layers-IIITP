# App Config
APP_NAME="Life-GPS Operating System"
APP_ENV=development
DEBUG=true

# Database Config
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/lifegps
SYNC_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/lifegps

# Google Gemini Config
GOOGLE_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-pro

# Logging
LOG_LEVEL=info
LOG_JSON_FORMAT=false
